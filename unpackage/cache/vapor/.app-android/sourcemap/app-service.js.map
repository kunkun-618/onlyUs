.brand { display: flex; flex-direction: row; align-items: center; }
.brand-mark { color: #bb715f; font-size: 24px; margin-right: 9px; }
.brand-name { color: #403831; font-size: 21px; font-weight: 700; letter-spacing: 2px; }
.brand-en { color: #aaa097; font-size: 9px; letter-spacing: 2px; margin-left: 12px; padding-top: 5px; }
.body { flex: 1; height: 0; }
.small { width: 32px; height: 32px; border-radius: 18px; border-width: 1px; }
.avatar-text { font-size: 13px; color: #926d59; }
.tabbar { display: flex; flex-direction: row; justify-content: space-around; padding: 12px 8px 8px; padding-bottom: calc(8px + env(safe-area-inset-bottom)); background-color: #fffdf9; border-top: 1px solid #eee7df; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; height: 46px; }
.tab-icon { font-size: 22px; color: #bcb3a9; height: 26px; }
.tab-label { font-size: 10px; color: #aea499; margin-top: 2px; }
.tab-selected { color: #b67862; }
.tab-dot { background-color: #b67862; height: 3px; width: 3px; border-radius: 2px; margin-top: 4px; }
.demo-bar { display: flex; flex-direction: row; justify-content: space-between; padding: 8px 22px; background-color: #eee9dc; }
.demo-label { font-size: 10px; color: #998872; }
