<template>
  <view class="app">
    <LoginPanel v-if="!entered" class="login-host" />
    <view v-else class="shell">
      <view class="topbar">
        <view class="brand">
          <text class="brand-mark">♥</text>
          <text class="brand-name">我们俩</text>
          <text class="brand-en">JUST US</text>
        </view>
        <view class="avatar small" @click="tab = 'settings'"><text class="avatar-text">{{ myName.slice(0, 1) }}</text></view>
      </view>
      <scroll-view class="body" direction="vertical" :scroll-into-view="scrollTarget" :scroll-with-animation="true">
        <view v-if="demo" class="demo-bar" @click="configOpen = true">
          <text class="demo-label">本地演示 · 数据仅保存在此设备</text>
          <text class="demo-action">连接云端 →</text>
        </view>
        <HomePanel v-if="tab === 'home'" />
        <view v-else-if="tab === 'chat'" class="page">
          <ChatPanel />
          <view id="chat-end" class="chat-end"></view>
        </view>
        <PhotosPanel v-else-if="tab === 'photos'" />
        <NotesPanel v-else-if="tab === 'notes'" />
        <SettingsPanel v-else />
      </scroll-view>
      <ChatComposer v-if="tab === 'chat'" />
      <view class="tabbar">
        <view v-for="item in tabs" :key="item.key" class="tab-item" @click="switchTab(item.key)">
          <text class="tab-icon" :class="{ 'tab-selected': tab === item.key }">{{ item.icon }}</text>
          <text class="tab-label" :class="{ 'tab-selected': tab === item.key }">{{ item.label }}{{ item.key === 'chat' && unread ? ' · ' + unread : '' }}</text>
          <view v-if="tab === item.key" class="tab-dot"></view>
        </view>
      </view>
    </view>
    <ConnectionDialog v-if="configOpen" />
    <NoteEditor v-if="noteOpen" />
  </view>
</template>

<script setup lang="ts">
import { onShow, onHide } from '@dcloudio/uni-app'
import { providePairContext } from './composables/context'
import { usePairApp } from './composables/usePairApp'
import LoginPanel from './components/LoginPanel.uvue'
import HomePanel from './components/HomePanel.uvue'
import ChatPanel from './components/ChatPanel.uvue'
import ChatComposer from './components/ChatComposer.uvue'
import PhotosPanel from './components/PhotosPanel.uvue'
import NotesPanel from './components/NotesPanel.uvue'
import SettingsPanel from './components/SettingsPanel.uvue'
import ConnectionDialog from './components/ConnectionDialog.uvue'
import NoteEditor from './components/NoteEditor.uvue'

const app = usePairApp()
providePairContext(app)
const { entered, tab, myName, scrollTarget, demo, configOpen, noteOpen, tabs, unread, switchTab } = app
onShow(app.handleShow)
onHide(app.handleHide)
</script>

