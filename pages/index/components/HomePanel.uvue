<template>
  <view class="page home-page">
    <view class="greeting">
      <text class="eyebrow">{{ today }} · OUR LITTLE SPACE</text>
      <text class="page-title">平凡的日子，也想和你一起。</text>
      <text class="page-description">这里的每一件小事，都与你有关。</text>
    </view>
    <view class="couple-row">
      <view class="person">
        <view class="avatar peach"><text class="person-letter">{{ myName.slice(0, 1) }}</text></view>
        <text class="person-name">{{ myName }}</text>
        <text class="person-role">此刻的我</text>
      </view>
      <view class="connection">
        <text class="connection-line">— — ♥ — —</text>
        <text class="connection-caption">只有你，和我</text>
      </view>
      <view class="person">
        <view class="avatar sage"><text class="person-letter sage-text">{{ partnerName.slice(0, 1) }}</text></view>
        <text class="person-name">{{ partnerName }}</text>
        <text class="person-role">心里的你</text>
      </view>
    </view>
    <view class="miss-card">
      <text class="miss-kicker">有些想念，不必等到见面</text>
      <view class="heart-orbit" @click="sendMiss">
        <view class="heart-middle">
          <view class="heart-button" :class="{ 'heart-active': heartActive }"><text class="heart-symbol">♥</text></view>
        </view>
      </view>
      <text class="miss-title">{{ heartActive ? '把想念，送到你身边' : '我有一点，想你了' }}</text>
      <text class="miss-hint">{{ demo ? '轻触爱心，记录这一刻的想念' : '轻触爱心，向对方发送一份想念' }}</text>
      <view class="miss-footer">
        <text class="miss-count">今天的小想念</text>
        <text class="miss-number">{{ todayMiss }} 次</text>
        <text class="miss-divider">|</text>
        <text class="miss-count">双向奔赴的日常</text>
      </view>
    </view>
    <view class="today-history">
      <view class="section-heading history-heading">
        <text class="section-title">今天的想念</text>
        <text class="text-link history-link" @click="openHistory">查看详情 ›</text>
      </view>
      <view v-if="todayRecords.length" class="today-list">
        <view v-for="(item, index) in todayRecords" :key="item.id" class="today-row" :class="{ 'row-last': index === todayRecords.length - 1 }">
          <text class="activity-heart today-heart">♥</text>
          <view class="grow">
            <text class="activity-title">{{ item.sender_id === userId ? '你' : partnerName }} 说：想你了</text>
            <text class="subtle">{{ formatTime(item.created_at) }}</text>
          </view>
        </view>
      </view>
      <view v-else class="activity-card today-empty">
        <text class="subtle">今天还没有想念记录</text>
      </view>
    </view>
    <view class="section-heading">
      <text class="section-title">把日常，慢慢收藏</text>
      <text class="subtle">OUR EVERYDAY</text>
    </view>
    <view class="shortcut-row">
      <view class="shortcut chat-shortcut" @click="switchTab('chat')">
        <text class="shortcut-icon">“</text>
        <text class="shortcut-title">说说话</text>
        <text class="shortcut-sub">有好多小事想告诉你</text>
        <text class="shortcut-arrow">聊一会儿 →</text>
      </view>
      <view class="shortcut photo-shortcut" @click="switchTab('photos')">
        <text class="shortcut-icon green">▧</text>
        <text class="shortcut-title">我们的相册</text>
        <text class="shortcut-sub">定格每一个好时刻</text>
        <text class="shortcut-arrow green">去看看 →</text>
      </view>
    </view>
    <view class="note-entry" @click="switchTab('notes')">
      <view class="note-entry-icon"><text class="note-icon">✎</text></view>
      <view class="grow">
        <text class="shortcut-title">写给时光的小纸条</text>
        <text class="shortcut-sub">悄悄记下，或者分享给你</text>
      </view>
      <text class="note-arrow">→</text>
    </view>
    <view class="section-heading">
      <text class="section-title">最近的小动静</text>
      <text class="subtle">JUST BETWEEN US</text>
    </view>
    <view class="activity-card" @click="openHistory">
      <view class="activity-dot"></view>
      <view class="grow">
        <text class="activity-title">{{ latestMiss ? (latestMiss.sender_id === userId ? '你' : partnerName) + ' 说：想你了' : '还没有想念记录' }}</text>
        <text class="subtle">{{ latestMiss ? formatTime(latestMiss.created_at) : '点击上面的爱心，送出第一份想念' }}</text>
      </view>
      <text class="activity-heart">♥</text>
    </view>
    <text class="home-footnote">世界很大，这里刚好容下我们俩。</text>
    <view v-if="historyOpen" class="overlay" @click="closeHistory">
      <scroll-view class="modal history-modal" :class="{ 'history-modal-compact': compactModal }" direction="vertical" @click.stop>
        <view class="history-top">
          <text class="eyebrow">OUR LITTLE MOMENTS</text>
          <text class="modal-title">想念记录</text>
          <text class="history-close" @click="closeHistory">×</text>
        </view>
        <text class="field-label">起止日期（YYYY-MM-DD，留空为全部）</text>
        <view class="date-row">
          <input v-model="startDate" class="input history-input" placeholder="开始日期" />
          <text class="date-separator">至</text>
          <input v-model="endDate" class="input history-input" placeholder="结束日期" />
        </view>
        <text class="field-label">发送人</text>
        <view class="sender-row">
          <text class="sender-option" :class="{ 'sender-selected': senderFilter === 'all' }" @click="senderFilter = 'all'">全部</text>
          <text class="sender-option" :class="{ 'sender-selected': senderFilter === 'me' }" @click="senderFilter = 'me'">我</text>
          <text class="sender-option sender-last" :class="{ 'sender-selected': senderFilter === 'partner' }" @click="senderFilter = 'partner'">对方</text>
        </view>
        <button class="primary history-submit" :disabled="historyLoading" @click="runHistoryQuery">{{ historyLoading ? '查询中…' : '查询' }}</button>
        <text v-if="historyError" class="history-error">{{ historyError }}</text>
        <view v-for="(item, index) in historyRows" :key="item.id" class="history-row" :class="{ 'row-last': index === historyRows.length - 1 }">
          <view class="grow">
            <text class="activity-title">{{ item.sender_id === userId ? '你' : partnerName }} 说：想你了</text>
            <text class="subtle">{{ formatTime(item.created_at) }}</text>
          </view>
          <text class="activity-heart">♥</text>
        </view>
        <text v-if="!historyLoading && !historyRows.length && !historyError" class="history-empty">没有符合条件的记录</text>
        <text v-if="historyMore && !historyLoading" class="text-link history-more" @click="loadHistoryPage">加载更多</text>
        <text v-if="historyLoading && historyRows.length" class="history-status">正在加载…</text>
        <text class="text-link history-dismiss" @click="closeHistory">关闭</text>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, onUnmounted, ref, watch } from 'vue'
import { usePairContext } from '../composables/context'
import { cloud, request } from '../../../utils/cloud'
const context = usePairContext()
const { today, myName, partnerName, sendMiss, heartActive, demo, todayMiss, switchTab, latestMiss, userId, formatTime, misses } = context
const todayRecords = computed(() => [...context.todayMisses.value])
const historyOpen = ref(false)
const startDate = ref('')
const endDate = ref('')
const senderFilter = ref('all')
const historyRows = ref<any[]>([])
const historyLoading = ref(false)
const historyMore = ref(false)
const historyError = ref('')
const compactModal = ref(uni.getWindowInfo().windowHeight < 540)
let historyGeneration = 0
let historyScope = ''
let activeFilters = { start: '', end: '', sender: 'all' }
function currentScope() { return JSON.stringify([cloud.url, cloud.key, userId.value, demo.value]) }
function closeHistory() {
  historyOpen.value = false
  historyGeneration++
  historyLoading.value = false
}
function openHistory() {
  historyOpen.value = true
  startDate.value = ''
  endDate.value = ''
  senderFilter.value = 'all'
  historyRows.value = []
  historyMore.value = false
  historyError.value = ''
  runHistoryQuery()
}
function validDate(value: string) {
  if (!value) return true
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false
  const date = new Date(value + 'T00:00:00')
  return Number.isFinite(date.getTime()) && date.getFullYear() === Number(value.slice(0, 4)) && date.getMonth() + 1 === Number(value.slice(5, 7)) && date.getDate() === Number(value.slice(8, 10))
}
function localDayAfter(value: string) {
  const date = new Date(value + 'T00:00:00')
  date.setDate(date.getDate() + 1)
  return date.toISOString()
}
function runHistoryQuery() {
  if (!validDate(startDate.value) || !validDate(endDate.value)) { historyError.value = '日期格式或日期值无效，请使用 YYYY-MM-DD'; return }
  if (startDate.value && endDate.value && startDate.value > endDate.value) { historyError.value = '开始日期不能晚于结束日期'; return }
  historyGeneration++
  historyScope = currentScope()
  activeFilters = { start: startDate.value, end: endDate.value, sender: senderFilter.value }
  historyRows.value = []
  historyMore.value = false
  historyError.value = ''
  historyLoading.value = false
  loadHistoryPage()
}
async function loadHistoryPage() {
  if (historyLoading.value) return
  const generation = historyGeneration
  const scope = historyScope
  const { start, end, sender } = activeFilters
  const cursor = historyRows.value[historyRows.value.length - 1]
  historyLoading.value = true
  try {
    let rows: any[]
    if (demo.value) {
      const cache = uni.getStorageSync('pair_demo')
      rows = (cache?.misses || misses.value).filter((item: any) => {
        const timestamp = Date.parse(item.created_at)
        const senderMatch = sender === 'all' || item.sender_id === (sender === 'me' ? userId.value : partnerId())
        return (!start || timestamp >= new Date(start + 'T00:00:00').getTime()) && (!end || timestamp < new Date(localDayAfter(end)).getTime()) && senderMatch && (!cursor || item.created_at < cursor.created_at || (item.created_at === cursor.created_at && String(item.id) < String(cursor.id)))
      }).sort((a: any, b: any) => b.created_at.localeCompare(a.created_at) || String(b.id).localeCompare(String(a.id))).slice(0, 50)
    } else {
      const filters = ['select=*', 'order=created_at.desc,id.desc', 'limit=50']
      if (start) filters.push('created_at=gte.' + encodeURIComponent(new Date(start + 'T00:00:00').toISOString()))
      if (end) filters.push('created_at=lt.' + encodeURIComponent(localDayAfter(end)))
      if (sender !== 'all') filters.push('sender_id=eq.' + encodeURIComponent(sender === 'me' ? userId.value : partnerId()))
      if (cursor) filters.push('or=' + encodeURIComponent('(created_at.lt.' + cursor.created_at + ',and(created_at.eq.' + cursor.created_at + ',id.lt.' + cursor.id + '))'))
      rows = await request('/rest/v1/miss_you_logs?' + filters.join('&'))
    }
    if (generation !== historyGeneration || scope !== currentScope() || !historyOpen.value) return
    historyRows.value.push(...rows)
    historyMore.value = rows.length === 50
  } catch (error: any) {
    if (generation === historyGeneration && scope === currentScope()) historyError.value = error?.message || '记录加载失败，请重试'
  } finally {
    if (generation === historyGeneration) historyLoading.value = false
  }
}
function partnerId() { return demo.value ? 'demo-partner' : context.members.value.find((member: any) => member.user_id !== userId.value)?.user_id || '' }
watch(() => currentScope(), () => {
  historyGeneration++
  historyRows.value = []
  historyMore.value = false
  historyLoading.value = false
  if (historyOpen.value) { historyScope = currentScope(); runHistoryQuery() }
})
watch(() => uni.getWindowInfo().windowHeight, height => { compactModal.value = height < 540 })
onUnmounted(() => { historyGeneration++ })
</script>

<style>
@import '../styles/shared.css';
.couple-row { display: flex; flex-direction: row; justify-content: center; align-items: center; padding: 28px 0 22px; }
.person { display: flex; flex-direction: column; align-items: center; }
.sage { background-color: #dfe6db; }
.sage-text { color: #7b8b70; }
.person-name { color: #5c5147; font-size: 13px; margin-top: 8px; }
.person-role { color: #b5aaa0; font-size: 10px; margin-top: 4px; }
.connection { display: flex; flex-direction: column; align-items: center; width: 128px; padding-bottom: 24px; }
.connection-line { color: #c89583; font-size: 17px; letter-spacing: 2px; }
.connection-caption { color: #b5a497; font-size: 10px; margin-top: 8px; }
.miss-card { display: flex; flex-direction: column; align-items: center; padding: 24px 14px 0; background-color: #f3e7de; border: 1px solid #eee0d5; border-radius: 20px; }
.miss-kicker { color: #a88b78; font-size: 11px; letter-spacing: 2px; }
.heart-orbit { width: 166px; height: 166px; border: 1px solid #e9d3c5; border-radius: 84px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 22px 0 17px; }
.heart-middle { width: 140px; height: 140px; border-radius: 72px; background-color: #edd9cb; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.heart-button { width: 110px; height: 110px; border-radius: 58px; background-color: #bd7966; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 7px 16px #d5b09e; }
.heart-active { background-color: #a95e50; transform: scale(1.08); }
.heart-symbol { font-size: 53px; color: #fff8ee; }
.miss-title { color: #745646; font-size: 21px; font-weight: 600; letter-spacing: 1px; }
.miss-hint { color: #b29785; font-size: 10px; margin-top: 9px; }
.miss-footer { align-self: stretch; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-top: 25px; border-top: 1px solid #e8d6c9; padding: 15px 0; }
.miss-count { color: #ab8b76; font-size: 10px; }
.miss-number { color: #a66a54; font-size: 12px; font-weight: 600; margin-left: 8px; }
.miss-divider { color: #d3bcaa; font-size: 12px; margin: 0 14px; }
.shortcut-row { display: flex; flex-direction: row; }
.shortcut { flex: 1; padding: 16px 14px; border-radius: 13px; border: 1px solid #eee3d9; }
.chat-shortcut { background-color: #f7efe5; margin-right: 11px; }
.photo-shortcut { background-color: #eef0e8; border-color: #e2e5da; }
.shortcut-icon { font-size: 35px; color: #ba8e69; height: 38px; }
.green { color: #8b967b; }
.shortcut-title { color: #5a5045; font-size: 14px; font-weight: 600; line-height: 23px; }
.shortcut-sub { color: #aa9a89; font-size: 10px; line-height: 21px; }
.shortcut-arrow { font-size: 10px; color: #a78569; margin-top: 15px; }
.note-entry { display: flex; flex-direction: row; align-items: center; background-color: #f5f0e8; border: 1px solid #ece5db; padding: 16px 13px; border-radius: 12px; margin-top: 12px; }
.note-entry-icon { width: 37px; height: 39px; border-radius: 9px; background-color: #ebe0d0; justify-content: center; align-items: center; display: flex; flex-direction: column; margin-right: 12px; }
.note-icon { color: #a78e6f; font-size: 25px; }
.note-arrow { font-size: 20px; color: #b3a28d; }
.activity-card { display: flex; flex-direction: row; align-items: center; padding: 16px; background-color: #fffdfa; border: 1px solid #eee7de; border-radius: 12px; }
.activity-dot { width: 7px; height: 7px; background-color: #bd8a74; border-radius: 4px; margin-right: 12px; }
.activity-title { font-size: 12px; color: #726355; line-height: 22px; }
.activity-heart { color: #c89583; font-size: 18px; }
.today-history { margin-top: 8px; }
.history-heading { margin-bottom: 8px; }
.history-link { padding: 4px 0; }
.today-list { display: flex; flex-direction: column; padding: 0 14px; background-color: #fffdfa; border: 1px solid #eee7de; border-radius: 12px; }
.today-row, .history-row { display: flex; flex-direction: row; align-items: center; padding: 12px 0; border-bottom: 1px solid #f0e9df; }
.row-last { border-bottom-width: 0; }
.today-heart { margin-right: 12px; }
.today-empty { justify-content: center; min-height: 54px; padding: 10px; }
.history-modal { display: flex; flex-direction: column; height: 460px; padding: 20px; }
.history-modal-compact { height: 300px; padding: 16px; }
.history-top { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.modal-title { margin: 5px 0 10px; }
.history-close { color: #927d6d; font-size: 26px; padding: 0 4px; }
.field-label { margin: 10px 0 7px; }
.date-row { display: flex; flex-direction: row; align-items: center; }
.history-input { flex: 1; min-width: 0; padding: 0 8px; font-size: 11px; }
.date-separator { color: #927d6d; font-size: 11px; padding: 0 7px; }
.sender-row { display: flex; flex-direction: row; }
.sender-option { flex: 1; text-align: center; padding: 9px 0; margin-right: 8px; border-radius: 8px; background-color: #f6f0e8; color: #927d6d; font-size: 12px; }
.sender-last { margin-right: 0; }
.sender-selected { background-color: #ead9cc; color: #8c5f4e; }
.history-submit { margin: 12px 0 6px; }
.history-row { padding: 10px 2px; }
.history-error { color: #ae5749; font-size: 11px; line-height: 18px; }
.history-empty, .history-status { color: #a79d93; font-size: 11px; padding: 16px 0; text-align: center; }
.history-more, .history-dismiss { padding: 9px 0; }
</style>
