	display: flex;
	flex-direction: column;
	padding: 12px 16px;
	background-color: #f6f0e8;

	.composer-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;

		.message-input {
			flex: 1;
			min-width: 0;
			border-radius: 10px;
			background-color: $pair-color-surface;
			padding: 10px 12px;
			font-size: 12px;
			height: 42px;
			box-sizing: border-box;
		}

		.send-button {
		margin-left: 9px;
		background-color: $pair-color-primary;
		color: #fffaf4;
		font-size: 12px;
		border-radius: 8px;
		line-height: 40px;
		padding: 0 16px;
		}

		.emoji-toggle {
			margin-right: 8px;
			padding: 0 8px;
			line-height: 40px;
			border-radius: 8px;
			background-color: #ead8c8;
			color: $pair-color-text;
			font-size: 12px;
		}
	}

	.emoji-panel {
		display: flex;
		flex-direction: column;
		padding-top: 14px;
		width: 100%;

		.panel-label {
			color: #927d6d;
			font-size: 11px;
			line-height: 24px;
		}

		.emoji-grid {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			padding: 4px 0 10px;
			
			.emoji-item {
				width: 12.5%;
				margin: 0;
				padding: 0;
				line-height: 40px;
				font-size: 24px;
				background-color: #f6f0e8;
				border: 0;
			}
		}
		
		.sticker-grid {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			
			.sticker-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 25%;
				margin: 0;
				padding: 6px 0;
				background-color: #f6f0e8;
				border: 0;
				
				.sticker-preview {
					width: 58px;
					height: 58px;
				}

				.sticker-label {
					color: #927d6d;
					font-size: 11px;
					line-height: 22px;
				}
			}
		}
	}
}
</style>
